#pragma once

#include "atlasnet/agent/backend/IAgentBackend.hpp"
#include "atlasnet/core/Json.hpp"
#include "atlasnet/core/shard/shard.hpp"

#include "boost/asio/io_context.hpp"
#include "boost/asio/local/stream_protocol.hpp"
#include "boost/asio/read.hpp"
#include "boost/asio/read_until.hpp"
#include "boost/asio/streambuf.hpp"
#include "boost/asio/write.hpp"

#include "enviroment/Enviroment.hpp"

#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>

namespace AtlasNet
{

class AgentDockerBackend : public IAgentBackend
{
public:
  AgentDockerBackend()
  {
    if (Env::Docker_ShardImageName.empty())
      throw std::invalid_argument(
          "ATLASNET_DOCKER_SHARD_IMAGE_NAME must be set");

    if (Env::DockerSocketPath.empty())
      throw std::invalid_argument("ATLASNET_DOCKER_SOCKET_PATH must be set");
  }

  ShardID SpawnShard(WorldID worldId, RegionID regionId) override
  {
    ConnectSocket();

    ShardID shardId = ShardID::Generate();

    _Json spawnContainerRequest;
    spawnContainerRequest["Image"] = Env::Docker_ShardImageName;

    spawnContainerRequest["HostConfig"]["NetworkMode"] =
        Env::Docker_NetworkName;

    spawnContainerRequest["Cmd"] = "--world_id=" + worldId.to_string() +
                                   " --region_id=" + std::to_string(regionId) +
                                   " --shard_id=" + shardId.to_string();

    std::string containerName =
        Env::StackName + "-shard-" + shardId.to_string();

    std::string body = spawnContainerRequest.dump();

    std::ostringstream request;
    request << "POST /v1.43/containers/create?name=" << containerName
            << " HTTP/1.1\r\n";
    request << "Host: localhost\r\n";
    request << "Content-Type: application/json\r\n";
    request << "Content-Length: " << body.size() << "\r\n";
    request << "Connection: close\r\n";
    request << "\r\n";
    request << body;

    std::cerr << "Creating Docker container for shard " << shardId.to_string()
              << " with request:\n"
              << request.str() << std::endl;
    std::string createResponse = MakeDockerRequest(request.str());

    auto responseJson = ParseHttpBodyAsJson(createResponse);

    if (!responseJson.contains("Id"))
      throw std::runtime_error("Docker did not return container ID:\n" +
                               createResponse);

    std::string containerId = responseJson["Id"];

    ConnectSocket();

    std::ostringstream startRequest;
    startRequest << "POST /v1.43/containers/" << containerId
                 << "/start HTTP/1.1\r\n";
    startRequest << "Host: localhost\r\n";
    startRequest << "Content-Length: 0\r\n";
    startRequest << "Connection: close\r\n";
    startRequest << "\r\n";

    std::cerr << "Starting Docker container for shard " << shardId.to_string()
              << " with request:\n"
              << startRequest.str() << std::endl;
    std::string startResponse = MakeDockerRequest(startRequest.str());

    auto startResponseJson = ParseHttpBodyAsJson(startResponse);

    if (startResponseJson.contains("message"))
      throw std::runtime_error("Failed to start container: " +
                               startResponseJson["message"].get<std::string>());

    std::cerr << "Started Docker container for shard " << shardId.to_string()
              << " with container ID: " << containerId << std::endl;

    return shardId;
  }

private:
  void ConnectSocket()
  {
    boost::system::error_code ec;

    if (socket.is_open())
      socket.close(ec);

    socket.connect(Env::DockerSocketPath, ec);

    if (ec)
      throw std::runtime_error("Docker socket connect failed: " + ec.message());
  }

  std::string MakeDockerRequest(const std::string& request)
  {
    boost::system::error_code ec;

    boost::asio::write(socket, boost::asio::buffer(request), ec);
    if (ec)
      throw std::runtime_error("write failed: " + ec.message());

    boost::asio::streambuf buffer;
    std::string result;

    while (true)
    {
      std::size_t n = boost::asio::read(socket, buffer.prepare(4096), ec);
      buffer.commit(n);

      if (n == 0)
        break;

      std::istream is(&buffer);
      result.append(std::istreambuf_iterator<char>(is),
                    std::istreambuf_iterator<char>());

      if (ec == boost::asio::error::eof)
        break;

      if (ec && ec != boost::asio::error::would_block)
        break;
    }

    return result;
  }

  _Json ParseHttpBodyAsJson(const std::string& response)
  {
    const char* sep = "\r\n\r\n";
    size_t pos = response.find(sep);

    if (pos == std::string::npos)
      throw std::runtime_error("Invalid HTTP response from Docker");

    std::string body = response.substr(pos + 4);

    if (body.empty())
      return _Json{};

    return _Json::parse(body);
  }

private:
  boost::asio::io_context io_context;
  boost::asio::local::stream_protocol::socket socket{io_context};
};

} // namespace AtlasNet