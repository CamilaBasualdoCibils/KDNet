{
  "group": {
    "default": {
      "targets": [
        "atlasnet-controller",
        "atlasnet-gateway",
        "atlasnet-cartograph",
        "atlasnet-dummy"
      ]
    }
  },
  "target": {
    
    "atlasnet-controller": {
      "context": ".",
      "dockerfile": "dev/docker/Production.Dockerfile",
      "target": "atlasnet-controller",
      "load": true,
      "tags": [
        "atlasnet-controller:latest"
      ]
    },
    "atlasnet-gateway": {
      "context": ".",
      "dockerfile": "dev/docker/Production.Dockerfile",
      "target": "atlasnet-gateway",
      "load": true,
      "tags": [
        "atlasnet-gateway:latest"
      ]
    },
    "atlasnet-cartograph": {
      "context": ".",
      "dockerfile": "dev/docker/Production.Dockerfile",
      "target": "atlasnet-cartograph",
      "load": true,
      "tags": [
        "atlasnet-cartograph:latest"
      ]
    },
    "atlasnet-dummy": {
      "context": ".",
      "dockerfile": "dev/docker/Production.Dockerfile",
      "target": "atlasnet-dummy",
      "load": true,
      "tags": [
        "atlasnet-dummy:latest"
      ]
    }
  }
}